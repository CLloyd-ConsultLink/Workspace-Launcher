<Window x:Class="WorkspaceLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workspace Manager"
        Icon="pack://application:,,,/Assets/WorkspaceLauncher.ico"
        Width="1180" Height="800" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI"
        Loaded="MainWindow_Loaded" Closing="MainWindow_Closing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="W" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Workspace Manager" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Your setup, ready when you are" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ConfigureSequenceButton" Content="Manage sequences"
                        ToolTip="Create and configure named launch sequences."
                        Padding="12,11" Margin="0,0,8,0"
                        Click="ConfigureSequenceButton_Click" VerticalAlignment="Center" />
                <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="LAUNCH SEQUENCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox x:Name="SequenceSelector" Width="155" DisplayMemberPath="Name"
                              ToolTip="Choose the sequence to launch. Use Manage sequences to create one."
                              SelectionChanged="SequenceSelector_SelectionChanged" />
                </StackPanel>
                <Button x:Name="LaunchSequenceButton" Content="Launch sequence"
                    ToolTip="Launch the selected sequence. Empty sequences cannot be launched."
                    Style="{StaticResource PrimaryButton}" Padding="12,11"
                    Click="LaunchSequenceButton_Click" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="YOUR WORKSPACES" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Button x:Name="NewWorkspaceButton" Content="+ New"
                                ToolTip="Create an empty workspace, then choose its desktop and add launch items."
                                Padding="10,5" FontSize="12"
                                HorizontalAlignment="Right" Click="NewWorkspaceButton_Click" />
                    </Grid>
                    <ListBox x:Name="WorkspaceList" Grid.Row="1" Margin="0,12,0,12"
                             BorderThickness="0" Background="Transparent"
                             SelectionChanged="WorkspaceList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="11,10" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EEF0FF" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="IsSelected" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F5F6FA" />
                                                </MultiTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding Items.Count, StringFormat={}{0} launch items}"
                                                   FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DesktopLabel}"
                                               FontSize="10" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoWorkspacesHint" Grid.Row="1" Margin="16,24"
                               Text="No workspaces yet. Choose + New to create your first workspace."
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top"
                               IsHitTestVisible="False" Visibility="Collapsed" />
                    <Button x:Name="DeleteWorkspaceButton" Grid.Row="2" Content="Delete workspace"
                            ToolTip="Delete this workspace and remove it from the saved launch sequence."
                            HorizontalAlignment="Stretch" Foreground="#B54450"
                            Click="DeleteWorkspaceButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="14"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22">
                <Grid x:Name="EditorPanel" IsEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="WORKSPACE NAME" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Give this workspace a name that helps you recognize its purpose."
                                     FontSize="18" FontWeight="SemiBold" Padding="11,9" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="VIRTUAL DESKTOP" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                            <ComboBox x:Name="DesktopComboBox"
                                      ToolTip="Choose the virtual desktop where this workspace's apps should open."
                                      DropDownOpened="DesktopComboBox_DropDownOpened"
                                      SelectedIndex="{Binding DesktopIndex, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Launch workspace" Style="{StaticResource PrimaryButton}"
                                    ToolTip="Launch this workspace now without running the saved sequence."
                                    Padding="15,10" Margin="0,0,8,0"
                                    Click="LaunchSelectedButton_Click" />
                            <Button x:Name="CloseWorkspaceButton" Content="Close workspace"
                                    Foreground="#B54450"
                                    ToolTip="Choose configured apps to close on this workspace's assigned virtual desktop."
                                    Padding="13,10" Click="CloseWorkspaceButton_Click" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="LAUNCH ITEMS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <Button Content="+ Add launch item"
                                ToolTip="Choose whether to add an application, website, or file, then enter its details."
                                Padding="11,7"
                                Click="AddLaunchItemButton_Click" />
                        <Button x:Name="EditItemButton" Content="Edit" Padding="11,7" Margin="8,0,0,4" Click="EditItemButton_Click" />
                        <Button x:Name="RemoveItemButton" Content="Remove"
                                ToolTip="Remove the selected application, website, or file from this workspace."
                                Padding="11,7" Margin="8,0,0,4"
                                Click="RemoveItemButton_Click" />
                        <Button x:Name="MoveUpButton" Content="Move up" Padding="11,7" Margin="8,0,0,4" Click="MoveItemUpButton_Click" />
                        <Button x:Name="MoveDownButton" Content="Move down" Padding="11,7" Margin="8,0,0,4" Click="MoveItemDownButton_Click" />
                    </WrapPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                    <DataGrid x:Name="LaunchItemsGrid" ItemsSource="{Binding Items}"
                              ToolTip="These applications, websites, and files open in the order shown. Double-click a row to edit it."
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserSortColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" ColumnHeaderHeight="38" GridLinesVisibility="None"
                              RowHeight="44" AlternatingRowBackground="#FAFBFD"
                              BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                              Background="White" FontSize="12"
                              MouseDoubleClick="LaunchItemsGrid_MouseDoubleClick"
                              SelectionChanged="LaunchItemsGrid_SelectionChanged" KeyDown="LaunchItemsGrid_KeyDown">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F7F8FB" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,11" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ITEM" Width="205">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="TypeBadge" CornerRadius="6"
                                                    Background="#EEF0FF" Margin="0,0,9,0">
                                                <TextBlock x:Name="TypeBadgeText" Text="APP"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="9" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Padding="6,4" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Website">
                                                <Setter TargetName="TypeBadgeText" Property="Text" Value="WEB" />
                                                <Setter TargetName="TypeBadge" Property="Background" Value="#E8F5EF" />
                                                <Setter TargetName="TypeBadgeText" Property="Foreground" Value="#287A55" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="File">
                                                <Setter TargetName="TypeBadgeText" Property="Text" Value="FILE" />
                                                <Setter TargetName="TypeBadge" Property="Background" Value="#FFF2E5" />
                                                <Setter TargetName="TypeBadgeText" Property="Foreground" Value="#A45D16" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="TARGET" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Target}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Target}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="EmptyItemsHint"
                            Background="White" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="22"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="This workspace is empty" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Choose + Add launch item to add an application, shortcut, website, or file."
                                       TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    </Grid>

                    <StackPanel Grid.Row="3">
                        <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,3,0,3" />
                        <Expander x:Name="ActivityExpander" Header="Workspace activity">
                        <TextBox x:Name="ActivityLog" Height="110" IsReadOnly="True" AcceptsReturn="True"
                                 ToolTip="Workspace launch and close results, skipped apps, and errors appear here."
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11" Padding="10"
                                 Background="#FAFBFD" />
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="2,6,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SaveStatusText" Text="Changes saved." FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <Button x:Name="SaveButton" Content="Retry save" Margin="8,0,0,0" Padding="5,2" Visibility="Collapsed" Click="SaveButton_Click" />
                </StackPanel>
                <TextBlock x:Name="SequenceStateText" Text="Changes are stored locally in your Windows app-data folder."
                           FontSize="11" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding Source={x:Static Application.Current}, Path=Version}"
                       FontSize="11" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       ToolTip="Installed version of Workspace Manager." />
        </Grid>
    </Grid>
</Window>
